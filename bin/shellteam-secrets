#!/usr/bin/env python3
"""shellteam-secrets: use the owner's API keys by NAME, never by value (SHE-135).

  shellteam-secrets list
      Names in the vault, and where each one is used.
  shellteam-secrets write FILE VAR[=SECRET] ... [--restart UNIT]
      Put secrets into an env file (.env). VAR alone means the secret has the
      same name. --restart UNIT: restart that systemd --user unit whenever one
      of these keys changes. The file is rewritten on every rotation.
  shellteam-secrets run SECRET ... [--remember] -- COMMAND ...
      Run one command with the secrets in its environment. Their values are
      masked in its output. --remember: re-run it whenever one of them changes
      (for pushing a key to a hosting CLI, e.g. vercel env add).
  shellteam-secrets forget FILE|COMMAND
      Stop updating that file or re-running that command on rotation.
  shellteam-secrets set NAME
      (Humans, in a terminal.) Store a value, typed without echo.

Keys are added and replaced in the dashboard: Settings -> Secrets. Replacing
one there updates every file and command recorded here.
"""

import argparse
import getpass
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent.parent))
from api.services import secrets_vault as vault  # noqa: E402


def main(argv: list[str]) -> int:
    if not argv or argv[0] in ("-h", "--help", "help"):
        print(__doc__.strip())
        return 0
    cmd, rest = argv[0], argv[1:]

    if cmd == "list":
        rows = vault.status()
        if not rows:
            print("The vault is empty. Add keys in Settings -> Secrets.")
        for row in rows:
            print(f"{row['name']}  (updated {row['updated_at']})")
            for use in row["uses"]:
                where = use.get("file") or use.get("command")
                extra = f", restarts {use['restart']}" if use.get("restart") else ""
                print(f"    {use['kind']}: {where}{extra}")
        return 0

    if cmd == "write":
        p = argparse.ArgumentParser(prog="shellteam-secrets write")
        p.add_argument("file")
        p.add_argument("vars", nargs="+")
        p.add_argument("--restart")
        a = p.parse_args(rest)
        path = vault.write_env(a.file, vault.parse_mapping(a.vars), a.restart)
        print(f"Wrote {', '.join(vault.parse_mapping(a.vars))} into {path}"
              + (f"; {a.restart} restarts on rotation." if a.restart else "."))
        return 0

    if cmd == "run":
        if "--" not in rest:
            raise vault.SecretsError("Put the command after `--`.")
        split = rest.index("--")
        names, command = rest[:split], rest[split + 1:]
        remember = "--remember" in names
        names = [n for n in names if n != "--remember"]
        return vault.run(names, command, remember=remember)

    if cmd == "forget":
        if len(rest) != 1:
            raise vault.SecretsError("Usage: shellteam-secrets forget FILE|COMMAND")
        print(f"Forgot {vault.forget(rest[0])} use(s).")
        return 0

    if cmd == "set":
        if len(rest) != 1:
            raise vault.SecretsError("Usage: shellteam-secrets set NAME (the value is prompted)")
        if not sys.stdin.isatty():
            raise vault.SecretsError("`set` is for humans in a terminal. Agents: ask the owner "
                                     "to add the key in Settings -> Secrets.")
        for r in vault.set_secret(rest[0], getpass.getpass(f"{rest[0]}: ")):
            print(f"{'ok ' if r['ok'] else 'FAILED'} {r['target']}: {r['detail']}")
        print(f"Saved {rest[0]}.")
        return 0

    raise vault.SecretsError(f"Unknown command {cmd!r}. Run shellteam-secrets --help.")


if __name__ == "__main__":
    try:
        sys.exit(main(sys.argv[1:]))
    except vault.SecretsError as e:
        print(f"shellteam-secrets: {e}", file=sys.stderr)
        sys.exit(2)
